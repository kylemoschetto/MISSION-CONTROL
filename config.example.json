{
  "terminal": "ghostty",
  "scanPath": "~/projects",
  "claudeDir": "~/.claude",
  "port": 9000,
  "timeSaved": {
    "preset": "non-programmer",
    "multiplier": 8,
    "presets": {
      "non-programmer": { "multiplier": 8, "label": "Non-Programmer / Executive" },
      "junior": { "multiplier": 2.5, "label": "Junior Developer" },
      "mid-level": { "multiplier": 1.8, "label": "Mid-Level Developer" },
      "senior": { "multiplier": 1.3, "label": "Senior Developer" }
    }
  }
}
